# The official CLI (`brightdata`, alias `bdata`) authenticates via `brightdata login`;
# `-k/--api-key <key>` overrides per invocation.
BRIGHT_DATA_API_TOKEN=replace-with-your-bright-data-api-token
BRIGHT_DATA_SERP_ZONE=replace-with-your-serp-zone-if-used
OPENAI_API_KEY=replace-with-your-openai-api-key
# TrueForge binds IPv6 localhost (::1) in standalone mode. 127.0.0.1 does NOT reach it —
# verified 2026-08-29: curl 127.0.0.1:8790 -> connection failed, localhost:8790 -> HTTP 200.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=openai/gpt-5-6-sol
MCP_PORT=8940
